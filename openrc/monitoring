#!/sbin/openrc-run
# Monitoring — OpenRC service script (Alpine & other OpenRC flavours)
# Path placeholders are substituted by install.sh
# The service runs as the dedicated non-login user "monitoring".

name="monitoring"
description="Monitoring — Linux System Dashboard"
HOME_DIR="__HOME__"
command="${HOME_DIR}/venv/bin/python"
command_args="${HOME_DIR}/app.py"
command_user="monitoring"
command_background="yes"
pidfile="/run/monitoring.pid"
directory="${HOME_DIR}"
output_log="/var/log/monitoring/monitoring.log"
error_log="/var/log/monitoring/monitoring.log"

depend() {
    need net
    after firewall
}

start_pre() {
    if [ ! -x "$command" ]; then
        command="$(command -v python3)"
    fi
    # Load full environment (port, bind, token, server, etc.)
    if [ -f /etc/monitoring.env ]; then
        # shellcheck source=/dev/null
        . /etc/monitoring.env
        export MONITORING_PORT MONITORING_BIND MONITORING_TOKEN MONITORING_SERVER MONITORING_HOME MONITORING_LOG_FILE MONITORING_PRIVILEGE_DIR PYBIN
    fi
    export MONITORING_PORT="${MONITORING_PORT:-8050}"
    export MONITORING_BIND="${MONITORING_BIND:-127.0.0.1}"
    mkdir -p /var/log/monitoring
    chown monitoring:monitoring /var/log/monitoring 2>/dev/null || chown monitoring /var/log/monitoring 2>/dev/null || true
}
