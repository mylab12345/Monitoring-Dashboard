#!/sbin/openrc-run
# Montoring — OpenRC service script (Alpine & other OpenRC flavours)
# Path placeholders are substituted by install.sh

name="montoring"
description="Montoring — Linux System Dashboard"
HOME_DIR="__HOME__"
command="${HOME_DIR}/venv/bin/python"
command_args="${HOME_DIR}/app.py"
command_background="yes"
pidfile="/run/montoring.pid"
directory="${HOME_DIR}"
output_log="${HOME_DIR}/montoring.log"
error_log="${HOME_DIR}/montoring.log"

depend() {
    need net
    after firewall
}

start_pre() {
    if [ ! -x "$command" ]; then
        command="$(command -v python3)"
    fi
    export MONTORING_PORT="${MONTORING_PORT:-8050}"
    [ -f /etc/montoring.env ] && . /etc/montoring.env && export MONTORING_PORT
}
