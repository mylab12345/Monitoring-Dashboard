[Unit]
Description=Monitoring — Linux System Dashboard
Documentation=https://github.com/mylab12345/Montoring
After=network.target libvirtd.service
Wants=network.target

[Service]
Type=simple
EnvironmentFile=/etc/monitoring.env
WorkingDirectory=/opt/monitoring
ExecStart=/opt/monitoring/venv/bin/python /opt/monitoring/app.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
