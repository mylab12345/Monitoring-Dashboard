[Unit]
Description=Monitoring — Linux System Dashboard
Documentation=https://github.com/mylab12345/Monitoring-Dashboard
After=network.target libvirtd.service
Wants=network.target

[Service]
Type=simple
EnvironmentFile=__ENVFILE__
WorkingDirectory=__HOME__
ExecStart=__PYBIN__ __HOME__/app.py
Restart=always
RestartSec=5
User=monitoring
Group=monitoring
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LIBVIRT_DEFAULT_URI=qemu:///system
LogsDirectory=monitoring
StateDirectory=monitoring
# Sandbox hardening (safe subset).
# WARNING: ProtectKernelTunables/ProtectKernelModules/ProtectControlGroups,
# RestrictSUIDSGID and NoNewPrivileges are deliberately NOT used — systemd
# sets no_new_privs for them, which prevents sudo from gaining root and
# breaks every privileged helper ("sudo: The 'no new privileges' flag is
# set"). ProtectSystem=full/ProtectHome/PrivateTmp do not imply it and keep
# the code and home directory read-only for the service account.
ProtectSystem=full
# ProtectSystem=full also makes /usr, /etc and boot filesystems read-only in
# the service mount namespace. That is correct for the dashboard process, but
# it also applies to its passwordless-sudo package helper: apt/dpkg must be
# able to replace files such as /usr/bin/[ and update /etc and /boot. These
# are explicit mount-namespace exceptions, not Unix permissions for the
# monitoring user; only the root-owned, argument-validating helper can use
# root privileges to write them. /var remains writable under ProtectSystem=full
# for package databases, caches and logs.
# The "-" prefix is required for /boot and /efi: many hosts have no /efi (or
# no separate /boot in containers), and systemd refuses to start a service
# whose ReadWritePaths= names a missing path (status=226/NAMESPACE) unless
# the entry is prefixed with "-".
# If a running service still has an older, read-only namespace, the package
# helpers do not fail: they run the validated transaction as a transient
# systemd unit in the host namespace (privileged/monitoring_hostns.py).
ReadWritePaths=/usr /etc -/boot -/efi
ProtectHome=read-only
PrivateTmp=true
# Supplementary groups are granted via usermod during install, not here.
# SUDO PROFILE (operator-selected): the service account holds UNRESTRICTED
# passwordless sudo — /etc/sudoers.d/monitoring grants it
# `monitoring ALL=(ALL:ALL) NOPASSWD: ALL` — so it can create, modify and
# delete any resource on the host. The application still routes its own
# operations through the validated helper commands installed in
# /usr/local/lib/monitoring (application-level input validation, not a
# sudo-layer restriction). The sandbox flags above still apply to this
# unit's mount namespace regardless of sudo, which is why ReadWritePaths
# above remains necessary for package operations started from the service.

[Install]
WantedBy=multi-user.target
