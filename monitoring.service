[Unit]
Description=Monitoring — Linux System Dashboard
Documentation=https://github.com/mylab12345/Montoring
After=network.target libvirtd.service
Wants=network.target

[Service]
Type=simple
EnvironmentFile=__ENVFILE__
WorkingDirectory=__HOME__
ExecStart=__PYBIN__ __HOME__/app.py
Restart=always
RestartSec=5
User=monitoring
Group=monitoring
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
LogsDirectory=monitoring
StateDirectory=monitoring
# Sandbox hardening (safe subset).
# WARNING: ProtectKernelTunables/ProtectKernelModules/ProtectControlGroups,
# RestrictSUIDSGID and NoNewPrivileges are deliberately NOT used — systemd
# sets no_new_privs for them, which prevents sudo from gaining root and
# breaks every privileged helper ("sudo: The 'no new privileges' flag is
# set"). ProtectSystem=full/ProtectHome/PrivateTmp do not imply it and keep
# the code and home directory read-only for the service account.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Supplementary groups are granted via usermod during install, not here.
# The service account uses passwordless sudo only for the whitelisted
# helper commands installed in /usr/local/lib/monitoring. It does not get
# root/ALL and is never permitted unrestricted filesystem write access.

[Install]
WantedBy=multi-user.target
