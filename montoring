#!/usr/bin/env bash
# ============================================================================
#  montoring — CLI control tool for the Montoring dashboard
#  Installed to /usr/local/bin/montoring by install.sh
#
#  Usage: montoring {start|stop|restart|status|logs|update|open|version}
# ============================================================================
HOME_DIR="__HOME__"
PIDFILE="/run/montoring.pid"
ENVFILE="/etc/montoring.env"
PORT="8050"

[ -f "$ENVFILE" ] && . "$ENVFILE"
PORT="${MONTORING_PORT:-$PORT}"
HOME_DIR="${MONTORING_HOME:-$HOME_DIR}"
URL="http://localhost:${PORT}"

c_green='\033[1;32m'; c_red='\033[1;31m'; c_yel='\033[1;33m'; c_off='\033[0m'
say()  { printf "${c_green}[montoring]${c_off} %s\n" "$*"; }
err()  { printf "${c_red}[montoring]${c_off} %s\n" "$*" >&2; }
warn() { printf "${c_yel}[montoring]${c_off} %s\n" "$*"; }

have_systemd() { command -v systemctl >/dev/null 2>&1 && [ -f /etc/systemd/system/montoring.service ] && ps -p 1 -o comm= 2>/dev/null | grep -q systemd; }
have_openrc()  { command -v rc-service >/dev/null 2>&1 && [ -x /etc/init.d/montoring ]; }

pybin() {
  if [ -n "${PYBIN:-}" ] && [ -x "$PYBIN" ]; then echo "$PYBIN";
  elif [ -x "$HOME_DIR/venv/bin/python" ]; then echo "$HOME_DIR/venv/bin/python";
  else command -v python3; fi
}

pid_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; }

start_proc() {
  if pid_running; then warn "already running (pid $(cat "$PIDFILE"))"; return 0; fi
  say "starting montoring on port ${PORT}…"
  cd "$HOME_DIR" || return 1
  nohup env MONTORING_PORT="$PORT" MONTORING_HOME="$HOME_DIR" "$(pybin)" "$HOME_DIR/app.py" \
    >> "$HOME_DIR/montoring.log" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 2
  if curl -fsS "$URL/api/version" >/dev/null 2>&1; then say "started ✓  → $URL"; else err "did not respond — check: montoring logs"; return 1; fi
}

stop_proc() {
  if pid_running; then
    say "stopping (pid $(cat "$PIDFILE"))…"
    kill "$(cat "$PIDFILE")" 2>/dev/null
    sleep 1
    kill -9 "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    say "stopped ✓"
  else
    warn "not running (no pidfile)"
  fi
}

show_systemd_status() { local out; out="$(systemctl status montoring --no-pager -l 2>/dev/null)" && [ -n "$out" ] && echo "$out" | head -12; }

case "${1:-status}" in
  start)
    if have_systemd && systemctl start montoring 2>/dev/null; then show_systemd_status || say "started (systemd) → $URL"
    elif have_openrc && rc-service montoring start 2>/dev/null; then rc-service montoring status 2>/dev/null || true
    else start_proc; fi ;;
  stop)
    if have_systemd && systemctl stop montoring 2>/dev/null; then say "stopped (systemd)"
    elif have_openrc && rc-service montoring stop 2>/dev/null; then say "stopped (openrc)"
    else stop_proc; fi ;;
  restart)
    if have_systemd && systemctl restart montoring 2>/dev/null; then show_systemd_status || say "restarted (systemd) → $URL"
    elif have_openrc && rc-service montoring restart 2>/dev/null; then rc-service montoring status 2>/dev/null || true
    else stop_proc; sleep 1; start_proc; fi ;;
  status)
    if have_systemd && show_systemd_status; then :
    elif have_openrc && rc-service montoring status 2>/dev/null; then :
    else
      if pid_running; then say "running (pid $(cat "$PIDFILE")) → $URL"
      elif curl -fsS "$URL/api/version" >/dev/null 2>&1; then say "responding at $URL (external process)"
      else err "not running"; fi
    fi ;;
  logs)
    if have_systemd && journalctl -u montoring -n 100 --no-pager 2>/dev/null; then :
    else tail -n 100 "$HOME_DIR/montoring.log" 2>/dev/null || err "no log file found"; fi ;;
  update)
    if [ -x "$HOME_DIR/update.sh" ]; then shift; exec bash "$HOME_DIR/update.sh" "$@"
    else err "No $HOME_DIR/update.sh — run the repo's update.sh instead."; fi ;;
  open)
    if command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 &
    else say "Open $URL in your browser."; fi ;;
  version)
    curl -fsS "$URL/api/version" 2>/dev/null || sed -n '1p' "$HOME_DIR/VERSION" 2>/dev/null || err "not running" ;;
  *)
    echo "Usage: montoring {start|stop|restart|status|logs|update|open|version}"
    [ "$1" != "" ] && err "unknown command: $1"
    exit 1 ;;
esac
