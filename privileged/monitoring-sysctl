#!/usr/bin/env python3
"""monitoring-sysctl - reversible kernel-hardening profiles for the UI.

Only the fixed whitelist of sysctl keys below is ever touched; values are
validated integers. Original values are saved once to
/etc/monitoring-hardening.orig so --revert restores the exact pre-change
state (same pattern as monitoring-perf).

Modes:
  --check                    JSON status report (read-only).
  --apply --profile P        P is 'standard' or 'hardened'; applies live and
                             persists via /etc/sysctl.d/99-monitoring-hardening.conf
  --revert                   Restore original values and remove the drop-in.

This helper never invokes a shell.
"""
import json
import os
import re
import subprocess
import sys

ORIG_FILE = "/etc/monitoring-hardening.orig"
SYSCTL_DROPIN = "/etc/sysctl.d/99-monitoring-hardening.conf"
INT_RE = re.compile(r"^[0-9]+$")

# key -> allowed value range (inclusive)
KEYS = {
    "kernel.randomize_va_space": (0, 2),
    "kernel.kptr_restrict": (0, 2),
    "kernel.dmesg_restrict": (0, 1),
    "kernel.yama.ptrace_scope": (0, 3),
    "kernel.perf_event_paranoid": (-1, 3),
    "kernel.unprivileged_bpf_disabled": (0, 2),
}
PROFILES = {
    "standard": {
        "kernel.randomize_va_space": 2,
        "kernel.kptr_restrict": 1,
        "kernel.dmesg_restrict": 1,
        "kernel.yama.ptrace_scope": 1,
    },
    "hardened": {
        "kernel.randomize_va_space": 2,
        "kernel.kptr_restrict": 2,
        "kernel.dmesg_restrict": 1,
        "kernel.yama.ptrace_scope": 2,
        "kernel.perf_event_paranoid": 2,
        "kernel.unprivileged_bpf_disabled": 2,
    },
}


def _sysctl_path(key):
    return "/proc/sys/" + key.replace(".", "/")


def _read(key):
    try:
        with open(_sysctl_path(key)) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def _capture(argv, timeout=20):
    try:
        r = subprocess.run(argv, shell=False, capture_output=True, text=True,
                           timeout=timeout, start_new_session=True)
        return r.returncode, r.stdout or "", r.stderr or ""
    except (OSError, subprocess.SubprocessError) as exc:
        return 127, "", str(exc)


def _apply_live(key, value):
    # argv only — the value is a validated integer string, the key is from
    # the fixed whitelist.
    return _capture(["sysctl", "-w", f"{key}={value}"])


def _status():
    return {
        "values": {key: _read(key) for key in KEYS},
        "orig_exists": os.path.exists(ORIG_FILE),
        "dropin_exists": os.path.exists(SYSCTL_DROPIN),
    }


def main(argv):
    if argv == ["--check"]:
        print(json.dumps(_status()))
        return 0
    if argv == ["--revert"]:
        if not os.path.exists(ORIG_FILE):
            print("monitoring-sysctl: nothing to revert", file=sys.stderr)
            return 1
        try:
            with open(ORIG_FILE) as fh:
                orig = json.load(fh)
        except (OSError, ValueError) as exc:
            print(f"monitoring-sysctl: cannot read originals: {exc}",
                  file=sys.stderr)
            return 1
        failed = 0
        for key, value in orig.items():
            if key not in KEYS:
                continue
            if not isinstance(value, int) or not (
                    KEYS[key][0] <= value <= KEYS[key][1]):
                continue
            code, _, err = _apply_live(key, value)
            if code != 0:
                print(f"[fail] {key}: {err.strip()}", file=sys.stderr)
                failed += 1
            else:
                print(f"[ok] {key}={value}")
        for path in (ORIG_FILE, SYSCTL_DROPIN):
            try:
                os.remove(path)
            except OSError:
                pass
        return 0 if not failed else 1
    if argv[:1] == ["--apply"]:
        profile = None
        if len(argv) == 3 and argv[1] == "--profile" and argv[2] in PROFILES:
            profile = argv[2]
        if profile is None:
            print("monitoring-sysctl: usage --apply --profile standard|hardened",
                  file=sys.stderr)
            return 2
        # Save originals once (never overwrite — first state wins).
        if not os.path.exists(ORIG_FILE):
            orig = {key: _read(key) for key in PROFILES[profile]
                    if _read(key) is not None}
            try:
                with open(ORIG_FILE, "w") as fh:
                    json.dump(orig, fh)
                os.chmod(ORIG_FILE, 0o600)
            except OSError as exc:
                print(f"monitoring-sysctl: cannot save originals: {exc}",
                      file=sys.stderr)
                return 1
        failed = 0
        lines = ["# Managed by monitoring (kernel hardening profile)"]
        for key, value in PROFILES[profile].items():
            lo, hi = KEYS[key]
            if not (lo <= value <= hi):
                continue
            code, _, err = _apply_live(key, value)
            if code != 0:
                print(f"[fail] {key}: {err.strip()}", file=sys.stderr)
                failed += 1
            else:
                print(f"[ok] {key}={value}")
                lines.append(f"{key} = {value}")
        try:
            with open(SYSCTL_DROPIN, "w") as fh:
                fh.write("\n".join(lines) + "\n")
        except OSError:
            pass
        return 0 if not failed else 1
    print("monitoring-sysctl: unknown arguments", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
