#!/usr/bin/env python3
"""monitoring-kill - bounded process termination for the monitoring UI.

Only a validated numeric PID may be killed (never PID 1). This helper is the
sole kill privilege granted to the service account and it never invokes a
shell.
"""
import os
import signal
import sys
import time


def _pid_ok(pid):
    if not isinstance(pid, int):
        return False
    if pid <= 1 or pid > 1000000:
        return False
    # Never kill this helper itself or its parent (sudo/monitoring)
    if pid == os.getpid() or pid == os.getppid():
        return False
    return True


def _process_exists(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # Process exists but we can't signal it (different user)
        # Existence check via /proc
        return os.path.exists(f"/proc/{pid}")
    except Exception:
        return False


def main(argv):
    if "--check" in argv or argv and argv[0] == "--check":
        print("monitoring-kill: ok")
        return 0

    force = "--force" in argv
    pid_args = [a for a in argv if a != "--force"]
    if len(pid_args) != 1:
        print("monitoring-kill: usage <pid> [--force]", file=sys.stderr)
        return 2
    try:
        pid = int(pid_args[0])
    except ValueError:
        print("monitoring-kill: invalid pid", file=sys.stderr)
        return 2
    if not _pid_ok(pid):
        print("monitoring-kill: invalid pid", file=sys.stderr)
        return 2

    try:
        os.kill(pid, signal.SIGKILL if force else signal.SIGTERM)
    except ProcessLookupError:
        return 0
    except PermissionError:
        print("monitoring-kill: permission denied", file=sys.stderr)
        return 1

    if not force:
        for _ in range(6):
            if not _process_exists(pid):
                return 0
            time.sleep(0.5)
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except PermissionError:
            print("monitoring-kill: permission denied on SIGKILL", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
