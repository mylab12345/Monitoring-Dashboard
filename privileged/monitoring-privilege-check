#!/usr/bin/env python3
"""monitoring-privilege-check - inspect the monitoring service account.

Useful as `monitoring check-privileges`. When run as the `monitoring` account
(or by an administrator with sudo), it reports:

  * the running account / uid / groups
  * whether the sudoers fragment is present
  * whether each privileged helper exists
  * whether passwordless sudo actually allows each helper (best-effort)

It never requires and never uses `sudo ALL`.
"""
import grp
import json
import os
import pwd
import shutil
import subprocess
import sys

SUDOERS_FILE = "/etc/sudoers.d/monitoring"
PRIV_DIR = os.environ.get("MONITORING_PRIVILEGE_DIR", "/usr/local/lib/monitoring")
HELPERS = [
    "monitoring-systemctl",
    "monitoring-package",
    "monitoring-journal-vacuum",
    "monitoring-clean-old-logs",
    "monitoring-vm",
    "monitoring-vm-config",
    "monitoring-qemu",
    "monitoring-kill",
    "monitoring-zombie-clean",
]


def _human_groups(gids):
    names = []
    for gid in gids:
        try:
            name = grp.getgrgid(gid).gr_name
        except KeyError:
            name = str(gid)
        if name not in names:
            names.append(name)
    return names


def _sudo_check(helper):
    exe = os.path.join(PRIV_DIR, helper)
    if not os.path.isfile(exe) or not os.access(exe, os.X_OK):
        return "helper-not-found"
    if os.geteuid() == 0:
        # As root we cannot prove the monitoring user grant without dropping
        # privileges; report the file state and let the service API confirm.
        return "root-direct-ok"
    sudo = shutil.which("sudo")
    if not sudo:
        return "sudo-missing"
    try:
        r = subprocess.run([sudo, "-n", "--", exe, "--check"],
                           capture_output=True, text=True, timeout=8)
        return "ok" if r.returncode == 0 else f"denied(rc={r.returncode})"
    except Exception as exc:
        return f"error:{type(exc).__name__}"


def main(argv):
    global PRIV_DIR
    if "--check" in argv or argv and argv[0] == "--check":
        print("monitoring-privilege-check: ok")
        return 0
    if "--dir" in argv:
        try:
            idx = argv.index("--dir")
            PRIV_DIR = argv[idx + 1]
        except (IndexError, ValueError):
            print("monitoring-privilege-check: --dir requires a path", file=sys.stderr)
            return 2
    pretty = "--json" not in argv
    report = {
        "service_user": "monitoring",
        "uid": os.geteuid(),
        "user": pwd.getpwuid(os.geteuid()).pw_name if os.geteuid() > 0 else "root",
        "groups": _human_groups(os.getgroups()),
        "sudoers_file": SUDOERS_FILE,
        "sudoers_present": os.path.isfile(SUDOERS_FILE),
        "privilege_dir": PRIV_DIR,
        "helpers": [],
    }
    for helper in HELPERS:
        report["helpers"].append({
            "name": helper,
            "status": _sudo_check(helper),
            "path": os.path.join(PRIV_DIR, helper),
        })

    if pretty:
        print(f"Monitoring service account: {report['user']} (uid {report['uid']})")
        print(f"Groups: {', '.join(report['groups']) or '(none)'}")
        print(f"Sudoers fragment: {report['sudoers_file']} "
              f"({'present' if report['sudoers_present'] else 'missing'})")
        print("Privileged helpers:")
        for h in report["helpers"]:
            status = "OK" if h["status"] == "ok" else h["status"]
            print(f"  {h['name']:<28} {status}")
        return 0
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
