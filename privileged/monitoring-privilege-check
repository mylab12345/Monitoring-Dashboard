#!/usr/bin/env python3
"""monitoring-privilege-check - inspect the monitoring service account.

Useful as `monitoring check-privileges`. When run as the `monitoring` account
(or by an administrator with sudo), it reports:

  * the running account / uid / groups
  * whether the sudoers fragment is present
  * which sudo profile is active: full access (NOPASSWD: ALL) or the
    least-privilege helper whitelist
  * whether each privileged helper exists
  * whether passwordless sudo actually allows each helper (best-effort)
"""
import grp
import json
import os
import pwd
import re
import shutil
import subprocess
import sys

SUDOERS_FILE = "/etc/sudoers.d/monitoring"
PRIV_DIR = os.environ.get("MONITORING_PRIVILEGE_DIR", "/usr/local/lib/monitoring")
# Every helper the monitoring account may invoke through passwordless sudo.
# Must match sudoers/monitoring and monitor/commands.py PRIVILEGED_HELPERS.
HELPERS = [
    "monitoring-systemctl",
    "monitoring-self-repair",
    "monitoring-package",
    "monitoring-maintain",
    "monitoring-perf",
    "monitoring-self-update",
    "monitoring-journal-vacuum",
    "monitoring-clean-old-logs",
    "monitoring-vm",
    "monitoring-vm-config",
    "monitoring-qemu",
    "monitoring-kill",
    "monitoring-zombie-clean",
    "monitoring-privilege-check",
    "monitoring-nice",
    "monitoring-smart",
    "monitoring-sysctl",
    "monitoring-rc",
    "monitoring-snap",
]


def _human_groups(gids):
    names = []
    for gid in gids:
        try:
            name = grp.getgrgid(gid).gr_name
        except KeyError:
            name = str(gid)
        if name not in names:
            names.append(name)
    return names


def _mount_status(path):
    """Inspect mount flags without treating service-user permissions as errors."""
    item = {"path": path, "exists": os.path.exists(path),
            "read_only": False, "known": True, "options": ""}
    if not item["exists"]:
        return item
    findmnt = shutil.which("findmnt")
    if not findmnt:
        item["known"] = False
        return item
    try:
        result = subprocess.run(
            [findmnt, "--noheadings", "--output", "OPTIONS", "--target", path],
            shell=False, capture_output=True, text=True, timeout=5,
        )
        item["options"] = (result.stdout or "").strip()
        if result.returncode != 0 or not item["options"]:
            item["known"] = False
        else:
            item["read_only"] = "ro" in {part.strip() for part in item["options"].split(",")}
    except (OSError, subprocess.SubprocessError):
        item["known"] = False
    return item


def _sudo_grant():
    """(passwordless, full_access) for the calling account.

    `sudo -n -l` only reports what the caller may run; it grants nothing.
    full_access is True when a NOPASSWD: ALL rule applies (the full-access
    profile in /etc/sudoers.d/monitoring) rather than a listing of specific
    whitelisted commands (the least-privilege profile).
    """
    if os.geteuid() == 0:
        return True, True
    sudo = shutil.which("sudo")
    if not sudo:
        return False, False
    try:
        r = subprocess.run([sudo, "-n", "-l"], capture_output=True,
                           text=True, timeout=8)
    except Exception:
        return False, False
    if r.returncode != 0:
        return False, False
    full = bool(re.search(r"NOPASSWD:\s*ALL(?![\w/.-])", r.stdout or ""))
    return True, full


def _sudo_check(helper):
    exe = os.path.join(PRIV_DIR, helper)
    if not os.path.isfile(exe) or not os.access(exe, os.X_OK):
        return "helper-not-found"
    if os.geteuid() == 0:
        # As root we cannot prove the monitoring user grant without dropping
        # privileges; report the file state and let the service API confirm.
        return "root-direct-ok"
    sudo = shutil.which("sudo")
    if not sudo:
        return "sudo-missing"
    try:
        r = subprocess.run([sudo, "-n", "--", exe, "--check"],
                           capture_output=True, text=True, timeout=8)
        return "ok" if r.returncode == 0 else f"denied(rc={r.returncode})"
    except Exception as exc:
        return f"error:{type(exc).__name__}"


def main(argv):
    global PRIV_DIR
    if "--check" in argv or argv and argv[0] == "--check":
        print("monitoring-privilege-check: ok")
        return 0
    if "--dir" in argv:
        try:
            idx = argv.index("--dir")
            PRIV_DIR = argv[idx + 1]
        except (IndexError, ValueError):
            print("monitoring-privilege-check: --dir requires a path", file=sys.stderr)
            return 2
    pretty = "--json" not in argv
    passwordless, full_access = _sudo_grant()
    sudo_mode = ("full" if full_access
                 else "whitelisted-helpers" if passwordless
                 else "none")
    report = {
        "service_user": "monitoring",
        "uid": os.geteuid(),
        "user": pwd.getpwuid(os.geteuid()).pw_name if os.geteuid() > 0 else "root",
        "groups": _human_groups(os.getgroups()),
        "sudoers_file": SUDOERS_FILE,
        "sudoers_present": os.path.isfile(SUDOERS_FILE),
        "privilege_dir": PRIV_DIR,
        "sudo_access": {
            "passwordless": passwordless,
            "full": full_access,
            "mode": sudo_mode,
        },
        "helpers": [],
    }
    for helper in HELPERS:
        report["helpers"].append({
            "name": helper,
            "status": _sudo_check(helper),
            "path": os.path.join(PRIV_DIR, helper),
        })

    package_paths = [_mount_status(path) for path in
                     ("/usr", "/etc", "/var", "/boot", "/efi")]
    known_paths = [item for item in package_paths if item["exists"] and item["known"]]
    report["maintenance"] = {
        "package_write_paths": package_paths,
        "package_write_ready": (
            False if any(item["read_only"] for item in known_paths)
            else True if len(known_paths) == sum(item["exists"] for item in package_paths)
            else None
        ),
    }

    if pretty:
        print(f"Monitoring service account: {report['user']} (uid {report['uid']})")
        print(f"Groups: {', '.join(report['groups']) or '(none)'}")
        print(f"Sudoers fragment: {report['sudoers_file']} "
              f"({'present' if report['sudoers_present'] else 'missing'})")
        if sudo_mode == "full":
            print("Sudo grant: FULL — unrestricted passwordless root "
                  "(NOPASSWD: ALL). Any process running as this account can "
                  "create, modify or delete any resource on the host.")
        elif sudo_mode == "whitelisted-helpers":
            print("Sudo grant: whitelisted helper commands only "
                  "(least-privilege profile)")
        else:
            print("Sudo grant: none (no passwordless sudo available)")
        print("Privileged helpers:")
        for h in report["helpers"]:
            status = "OK" if h["status"] == "ok" else h["status"]
            print(f"  {h['name']:<28} {status}")
        write_ready = report["maintenance"]["package_write_ready"]
        if write_ready is False:
            print("Package maintenance filesystem: READ-ONLY (update the systemd "
                  "unit; do not chmod /usr)")
        elif write_ready is None:
            print("Package maintenance filesystem: unknown (findmnt unavailable)")
        else:
            print("Package maintenance filesystem: writable")
        return 0
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
