#!/usr/bin/env python3
"""monitoring-qemu - validated qemu-img resize for libvirt disks.

The helper only resizes a disk path that `virsh domblklist` reports for the
given domain, so a compromised service cannot use qemu-img to modify arbitrary
files. No shell is used.
"""
import os
import re
import shutil
import subprocess
import sys

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
PATH_RE = re.compile(r"^/[A-Za-z0-9/._-]+$")
MAX_PATH = 256


def dom_blk_paths(domname):
    virsh = shutil.which("virsh")
    if not virsh:
        return []
    # Try detailed list first, fallback to simple
    for args in (
        [virsh, "-c", "qemu:///system", "domblklist", "--details", domname],
        [virsh, "-c", "qemu:///system", "domblklist", domname],
    ):
        try:
            r = subprocess.run(args, shell=False, capture_output=True, text=True, timeout=20)
        except Exception:
            continue
        if r.returncode != 0:
            continue
        paths = []
        for line in (r.stdout or "").splitlines():
            line = line.strip()
            if not line or line.startswith(("Target", "----", "Type", "Capacity", "Source")):
                continue
            parts = line.split()
            # For --details: Type Device Target Source ...
            # For simple: Target Source
            # Source is the path we need
            for part in parts:
                # Heuristic: path containing / and ending with known disk extensions or containing /var/lib or /home or /srv
                if part.startswith("/") and len(part) <= MAX_PATH and PATH_RE.match(part):
                    # Ensure it's a real path, not just a flag
                    if "." in os.path.basename(part) or "/" in part:
                        # Avoid false positives like "/" alone
                        if part != "/" and os.path.isabs(part):
                            paths.append(part)
        if paths:
            return list(set(paths))
    return []


def main(argv):
    if "--check" in argv or argv and argv[0] == "--check":
        print("monitoring-qemu: ok")
        return 0

    if len(argv) != 4 or argv[0] != "resize":
        print("monitoring-qemu: usage resize <name> <disk_path> <size_gb>",
              file=sys.stderr)
        return 2
    _, name, disk_path, size_arg = argv
    if not isinstance(name, str) or not name or len(name) > 120 or name.startswith("-"):
        print("monitoring-qemu: invalid VM name", file=sys.stderr)
        return 2
    if NAME_RE.match(name) is None:
        print("monitoring-qemu: invalid VM name", file=sys.stderr)
        return 2
    if not isinstance(disk_path, str) or not disk_path or len(disk_path) > MAX_PATH:
        print("monitoring-qemu: invalid disk path", file=sys.stderr)
        return 2
    if PATH_RE.match(disk_path) is None:
        print("monitoring-qemu: invalid disk path", file=sys.stderr)
        return 2
    # Prevent path traversal via .. components
    if ".." in disk_path.split("/"):
        print("monitoring-qemu: invalid disk path (traversal)", file=sys.stderr)
        return 2
    # Ensure path is absolute and normalized
    norm = os.path.normpath(disk_path)
    if norm != disk_path:
        print("monitoring-qemu: invalid disk path (not normalized)", file=sys.stderr)
        return 2
    try:
        size_gb = int(size_arg)
    except ValueError:
        print("monitoring-qemu: invalid size", file=sys.stderr)
        return 2
    if size_gb < 1 or size_gb > 10000:
        print("monitoring-qemu: size out of range", file=sys.stderr)
        return 2

    # The disk must belong to this domain before it can be resized.
    allowed = dom_blk_paths(name)
    if disk_path not in allowed:
        print("monitoring-qemu: disk path is not attached to the named domain",
              file=sys.stderr)
        if allowed:
            print(f"monitoring-qemu: allowed paths: {', '.join(allowed[:5])}", file=sys.stderr)
        return 2

    # Verify file exists and is not a symlink to outside allowed area
    try:
        if not os.path.exists(disk_path):
            print("monitoring-qemu: disk file does not exist", file=sys.stderr)
            return 2
        # Check realpath still inside allowed list or same file
        real = os.path.realpath(disk_path)
        if real != disk_path and real not in allowed:
            # If symlink, ensure its target is also allowed
            if real not in allowed:
                print("monitoring-qemu: disk symlink target not allowed", file=sys.stderr)
                return 2
    except Exception:
        pass

    qemu_img = shutil.which("qemu-img")
    if not qemu_img:
        print("monitoring-qemu: qemu-img not found", file=sys.stderr)
        return 127
    try:
        result = subprocess.run([qemu_img, "resize", disk_path, f"{size_gb}G"],
                              shell=False, capture_output=True, text=True, timeout=60)
        if result.stdout:
            print(result.stdout.strip())
        if result.stderr:
            print(result.stderr.strip(), file=sys.stderr)
        return result.returncode
    except Exception as e:
        print(f"monitoring-qemu: execution failed: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
