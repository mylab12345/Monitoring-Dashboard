#!/usr/bin/env python3
"""monitoring-nice - bounded priority/affinity changes for the monitoring UI.

Only validated operations are allowed:
  renice <pid> <nice>          nice in -20..19, pid in 2..1000000
  affinity <pid> <cpulist>     cpulist is digits, commas and dashes only

The helper never invokes a shell and never touches PID 1 or itself.
"""
import os
import re
import subprocess
import sys

PID_MIN, PID_MAX = 2, 1000000
CPULIST_RE = re.compile(r"^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$")


def _pid_ok(pid):
    return isinstance(pid, int) and PID_MIN <= pid <= PID_MAX \
        and pid != os.getpid() and pid != os.getppid()


def _capture(argv, timeout=15):
    try:
        r = subprocess.run(argv, shell=False, capture_output=True, text=True,
                           timeout=timeout, start_new_session=True)
        return r.returncode, r.stdout or "", r.stderr or ""
    except (OSError, subprocess.SubprocessError) as exc:
        return 127, "", str(exc)


def main(argv):
    if argv == ["--check"]:
        print("monitoring-nice: ok")
        return 0
    if len(argv) != 3 or argv[0] not in ("renice", "affinity"):
        print("monitoring-nice: usage renice <pid> <nice> | affinity <pid> <cpulist>",
              file=sys.stderr)
        return 2
    try:
        pid = int(argv[1])
    except ValueError:
        print("monitoring-nice: invalid pid", file=sys.stderr)
        return 2
    if not _pid_ok(pid):
        print("monitoring-nice: invalid pid", file=sys.stderr)
        return 2
    if argv[0] == "renice":
        try:
            nice = int(argv[2])
        except ValueError:
            print("monitoring-nice: invalid nice value", file=sys.stderr)
            return 2
        if not -20 <= nice <= 19:
            print("monitoring-nice: nice out of range", file=sys.stderr)
            return 2
        code, out, err = _capture(["renice", str(nice), "-p", str(pid)])
    else:
        cpus = argv[2]
        if not CPULIST_RE.match(cpus) or len(cpus) > 64:
            print("monitoring-nice: invalid cpu list", file=sys.stderr)
            return 2
        code, out, err = _capture(["taskset", "-cp", cpus, str(pid)])
    if out:
        print(out.strip())
    if err:
        print(err.strip(), file=sys.stderr)
    return code if code >= 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
